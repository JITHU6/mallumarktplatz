# --- Supabase (required) -------------------------------------------------------
# Project URL and publishable (anon) key – safe to expose to the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key – SERVER ONLY. Used exclusively for GDPR account deletion.
# Never prefix with NEXT_PUBLIC_ and never import src/lib/supabase/admin.ts in client code.
SUPABASE_SECRET_KEY=

# --- Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@mallumarktplatz.de

# --- Maps (optional) -------------------------------------------------------------
# Public Mapbox token (URL-restricted) for the map view; without it the map view shows a notice.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional separate token for server-side geocoding (falls back to NEXT_PUBLIC_MAPBOX_TOKEN,
# then to city-level coordinates).
MAPBOX_GEOCODING_TOKEN=

# --- Legal / Impressum (required before going live) -------------------------------
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTAL_CITY=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_RESPONSIBLE=

# --- Social links in the footer (optional) ---------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Observability (optional) ----------------------------------------------------
# OTLP endpoint for traces. Local Jaeger: docker compose -f observability/docker-compose.yml up -d
# On Vercel, traces are exported automatically (Observability / tracing integrations).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...   # for hosted backends (Grafana Cloud, Honeycomb, Axiom, ...)
# debug | info | warn | error
LOG_LEVEL=info
# "pretty" for human-readable local logs, default is one JSON object per line
LOG_FORMAT=
